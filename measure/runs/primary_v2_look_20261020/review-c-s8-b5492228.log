  const module = { exports: {} };
  vm.runInNewContext(code, {
    module, exports: module.exports,
    require(id) {
      if (!(id in deps)) throw new Error("Unmocked dependency " + file + ": " + id);
      return deps[id];
    },
    process: { pid: 1, env: { WORKBOOKS_ROOT: root }, cwd: () => root + "/dashboard" },
    console: { log() {}, error() {} }, URLSearchParams
  }, { filename: file });
  return module.exports;
}
const files = load("dashboard/lib/filesystem.ts", {
  "fs/promises": {
    async stat(file) {
      if (!directories.has(file)) throw errno("ENOENT");
      return { isDirectory: () => true };
    },
    async mkdir(file, options) {
      if (directories.has(file) && !options?.recursive) throw errno("EEXIST");
      directories.add(file);
    },
    async writeFile(file, value) { memory.set(file, value); },
    async readFile(file) {
      if (readErrors.has(file)) throw errno(readErrors.get(file));
      if (!memory.has(file)) throw errno("ENOENT");
      return memory.get(file);
    },
    async rename(from, to) { memory.set(to, memory.get(from)); memory.delete(from); },
    async rm(file) { memory.delete(file); }
  },
  path, "./cutover": { assertWritable() {} }
});
const looks = load("dashboard/lib/look.ts");
const responses = { NextResponse: { json(body, options) {
  const status = options?.status ?? 200;
  return { status, ok: status >= 200 && status < 300, body, async json() { return body; } };
} } };
const projects = load("dashboard/app/api/projects/route.ts", {
  "next/server": responses, "@/lib/filesystem": files
});
const metadata = load("dashboard/app/api/projects/[projectId]/metadata/route.ts", {
  "next/server": responses, "@/lib/filesystem": files, "@/lib/look": looks
});
const primary = { type: "primary", seriesName: "Quest", levelNumber: "4", cefrLevel: "A1" };
const request = (body) => ({ json: async () => body });
const put = (id, body) => metadata.PUT(request(body), { params: Promise.resolve({ projectId: id }) });
const filename = (type, id) => path.join(root, type, id, "project.json");
function seed(type, id, value) {
  directories.add(path.join(root, type, id));
  memory.set(filename(type, id), typeof value === "string" ? value : JSON.stringify(value));
}
function handler(file, name, globals) {
  const source = fs.readFileSync(file, "utf8");
  const expression = new RegExp("const " + name + " = (async [\\s\\S]*?\\n  });").exec(source)?.[1];
  if (!expression) throw new Error("Handler not found: " + name);
  const code = ts.transpileModule("const run = " + expression + "; run;", {
    compilerOptions: { target: ts.ScriptTarget.ES2022 }
  }).outputText;
  return vm.runInNewContext(code, globals);
}

const fs = require("node:fs");
const path = require("node:path");
const vm = require("node:vm");
const ts = require("./dashboard/node_modules/typescript");
const assert = require("node:assert/strict");
const root = "/audit-memory";
const memory = new Map();
const directories = new Set();
function load(file, deps = {}) {
  const source = fs.readFileSync(file, "utf8");
  const code = ts.transpileModule(source, {
    compilerOptions: { module: ts.ModuleKind.CommonJS, target: ts.ScriptTarget.ES2022, esModuleInterop: true }
  }).outputText;
  const module = { exports: {} };
  vm.runInNewContext(code, {
    module, exports: module.exports,
    require(id) {
      if (!(id in deps)) throw new Error("Unmocked dependency " + file + ": " + id);
      return deps[id];
    },
    process: { env: { WORKBOOKS_ROOT: root }, cwd: () => "/audit-memory/dashboard" },
    console: { log() {}, error() {} }, URLSearchParams
  }, { filename: file });
  return module.exports;
}
const looks = load("dashboard/lib/look.ts");
const files = load("dashboard/lib/filesystem.ts", {
  "fs/promises": {
    async stat(file) {
      if (!directories.has(file)) throw new Error("ENOENT");
      return { isDirectory: () => true };
    },
    async mkdir(file) { directories.add(file); },
    async writeFile(file, value) { memory.set(file, value); },
    async readFile(file) {
      if (!memory.has(file)) throw new Error("ENOENT");
      return memory.get(file);
    }
  },
  path, "./cutover": { assertWritable() {} }
});
const responses = { NextResponse: { json(body, options) {
  return { status: options?.status ?? 200, body };
} } };
const projects = load("dashboard/app/api/projects/route.ts", {
  "next/server": responses, "@/lib/filesystem": files
});
const metadata = load("dashboard/app/api/projects/[projectId]/metadata/route.ts", {
  "next/server": responses, "@/lib/filesystem": files, "@/lib/look": looks
});
const request = (body) => ({ json: async () => body });
const put = (id, body) => metadata.PUT(request(body), { params: Promise.resolve({ projectId: id }) });
const seed = (kind, id, value) => {
  directories.add(path.join(root, kind, id));
  memory.set(path.join(root, kind, id, "project.json"), JSON.stringify(value));
};
const primary = { type: "primary", seriesName: "Origins", levelNumber: "1", cefrLevel: "A0" };
let failures = 0;
let passes = 0;
async function check(name, action) {
  try { await action(); passes++; console.log("PASS " + name); }
  catch (error) { failures++; console.log("FAIL " + name + ": " + error.message); }
}
(async () => {
  console.log("In-memory API probes. Storage is mocked. No content file or renderer is used.");
  await check("F1: only Primary metadata gets the new default", () => {
    assert.equal(looks.projectLook(primary), "chibi-quest");
    assert.equal(looks.projectLook({ ...primary, type: "secondary" }), "classic");
    assert.equal(looks.projectLook({ ...primary, type: undefined }), "classic");
    assert.equal(looks.projectLook(null), "classic");
  });
  await check("POST creates a new Primary project with no explicit look", async () => {
    const result = await projects.POST(request(primary));
    assert.equal(result.status, 200);
    assert.equal(Object.hasOwn(result.body.metadata, "look"), false);
    assert.equal(looks.projectLook(await files.readProjectMetadata(result.body.id)), "chibi-quest");
  });
  const shipped = { type: "primary", seriesName: "Quest", levelNumber: "4", cefrLevel: "A1", look: "classic" };
  seed("primary", "quest-4-a1", shipped);
  await check("F2: duplicate Primary POST returns 409 without a write", async () => {
    const file = path.join(root, "primary", "quest-4-a1", "project.json");
    const before = memory.get(file);
    const result = await projects.POST(request({ ...shipped, look: undefined }));
    assert.equal(result.status, 409);
    assert.match(result.body.error, /quest-4-a1.*already exists/);
    assert.equal(memory.get(file), before);
  });
  const secondary = { ...primary, type: "secondary", levelNumber: "3.1", cefrLevel: "A1" };
  seed("secondary", "origins-3.1-a1", secondary);
  await check("F2: duplicate legacy POST returns 409 without a write", async () => {
    const file = path.join(root, "secondary", "origins-3.1-a1", "project.json");
    const before = memory.get(file);
    const result = await projects.POST(request({ name: "origins-3.1-a1" }));
    assert.equal(result.status, 409);
    assert.match(result.body.error, /already exists/);
    assert.equal(memory.get(file), before);
  });
  await check("POST keeps its required-field error status", async () => {
    const result = await projects.POST(request({ type: "primary" }));
    assert.equal(result.status, 400);
    assert.match(result.body.error, /Missing required fields/);
  });
  await check("Settings-shaped PUT without look retains shipped classic", async () => {
    const result = await put("quest-4-a1", { ...shipped, look: undefined });
    assert.equal(result.status, 200);
    assert.equal((await files.readProjectMetadata("quest-4-a1")).look, "classic");
  });
  await check("unknown-look PUT returns 400 and leaves metadata unchanged", async () => {
    const file = path.join(root, "primary", "quest-4-a1", "project.json");
    const before = memory.get(file);
    const result = await put("quest-4-a1", { ...shipped, look: "invalid" });
    assert.equal(result.status, 400);
    assert.match(result.body.error, /quest-4-a1.*unknown look/);
    assert.equal(memory.get(file), before);
  });
  await check("known-look PUT succeeds and saves the requested look", async () => {
    const result = await put("quest-4-a1", { ...shipped, look: "chibi-quest" });
    assert.equal(result.status, 200);
    assert.equal((await files.readProjectMetadata("quest-4-a1")).look, "chibi-quest");
  });
  await check("PUT keeps its required-field error status", async () => {
    const result = await put("quest-4-a1", { look: "classic" });
    assert.equal(result.status, 400);
    assert.equal(result.body.error, "Missing required fields");
  });
  await check("book folders retain their original map", () => {
    assert.equal(looks.bookLook("origins-1"), "classic");
    assert.equal(looks.bookLook("quest-4"), "classic");
    assert.equal(looks.bookLook("quest-5"), "chibi-quest");
    assert.equal(looks.parseLook(undefined, "audit"), "classic");
  });
  console.log("SUMMARY " + passes + " passed; " + failures + " failed");
  process.exitCode = failures ? 1 : 0;
})().catch((error) => { console.error(error); process.exitCode = 2; });

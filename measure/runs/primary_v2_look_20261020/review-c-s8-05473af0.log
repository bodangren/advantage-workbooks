const quiet = { log() {}, error() {} };
function load(file, deps = {}, sourceOverride) {
  const source = sourceOverride ?? fs.readFileSync(file, "utf8");
  const code = ts.transpileModule(source, {
    compilerOptions: { module: ts.ModuleKind.CommonJS, target: ts.ScriptTarget.ES2022, esModuleInterop: true }
  }).outputText;
  const module = { exports: {} };
  vm.runInNewContext(code, {
    module, exports: module.exports,
    require(id) {
      if (!(id in deps)) throw new Error("Unmocked dependency " + file + ": " + id);
      return deps[id];
    },
    process: { env: { WORKBOOKS_ROOT: root }, cwd: () => "/audit-memory/dashboard" },
    console: quiet, URLSearchParams
  }, { filename: file });
  return module.exports;
}

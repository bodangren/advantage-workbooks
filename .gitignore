GEMINI.md
test-e2e-*/
test-project-*/
test-workbooks/
gemini-cron.log
.env
conductor/output.log
.opencode/

# Character-sheet candidates (generated; only the chosen sheets are kept)
docs/content-plans/character-sheets/candidates/

# Lesson media clip cache (made again from the package on demand)
content/primary/*/media/*/.clips/
# Voice samples for the one-time voice choice (local only)
content/primary/*/media/*/samples/
# Picture candidates (only the chosen picture is kept)
content/primary/*/media/*/candidates/
# Tutor Advantage clips (made again from .clips/; the bucket holds the published copies)
content/primary/*/media/*/tutor/
# Package writes that a stopped job left (store.ts writes a .tmp file, then renames it)
content/primary/**/*.tmp
# Test items, papers, keys and test audio live in ~/Desktop/level-tests/, never in a repository.
content/primary/*/assessments/
# Storytime song videos (made again from the package and the art by video/storytime-song/scripts/render.mjs)
content/storytime/*/media/*/song.mp4
content/storytime/*/media/*/song-phone.mp4
content/storytime/*/media/*/song-poster.jpg
content/storytime/*/media/*/song-karaoke.mp4
content/storytime/*/media/*/song-phone-poster.jpg
# The Forge scene video (S27 option C): Forge keeps the source; forge/scene.json records it
content/storytime/*/media/*/forge/scene.mp4
# The gesture library frames (Forge keeps the source; forge-gestures/manifest.json records it)
content/storytime/forge-gestures/gestures/
# Storytime book audio clip cache (made again from the package by dashboard/scripts/storytime/book-audio.ts)
content/storytime/*/media/*/.clips/
